<Page x:Class="DiskSteward.App.Features.Apps.AppsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:DiskSteward.App.Localization"
      xmlns:common="clr-namespace:DiskSteward.App.Common"
      Style="{StaticResource {x:Type Page}}"
      ScrollViewer.CanContentScroll="False">
  <!-- CanContentScroll="False": WPF-UI's NavigationView then skips its own scroll viewer and
       the lists below get a real height (it wraps the page when this is true, the Page default). -->
  <Page.InputBindings>
    <KeyBinding Key="F5" Command="{Binding ReloadCommand}" />
  </Page.InputBindings>
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisible" />
    <!-- "Not reported" recedes so real dates and sizes stay the ones the eye finds. -->
    <Style x:Key="DateCell" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding HasDate}" Value="False">
          <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SizeCell" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding HasSize}" Value="False">
          <Setter Property="FontWeight" Value="Normal" />
          <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CollapsedWithoutLeftovers" TargetType="Border" BasedOn="{StaticResource Surface}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Leftovers.Count}" Value="0">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Page.Resources>

  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <common:PageHeader Grid.Row="0" Title="{l:Tr Nav_Apps}" Summary="{Binding CountText}">
      <common:PageHeader.Actions>
        <!-- Search and sort, as in Windows Settings > Installed apps -->
        <StackPanel Orientation="Horizontal">
          <ui:TextBox MinWidth="200" ToolTip="Ctrl+F" Margin="{StaticResource CardGap}"
                      PlaceholderText="{l:Tr Apps_Search}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
            <ui:TextBox.Icon>
              <common:AppIconElement Kind="Search" />
            </ui:TextBox.Icon>
          </ui:TextBox>
          <TextBlock Margin="{StaticResource InlineGap}" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" Text="{l:Tr Apps_SortBy}" />
          <ComboBox MinWidth="150" ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label"
                    SelectedValuePath="Value" SelectedValue="{Binding SortBy}" />
        </StackPanel>
      </common:PageHeader.Actions>
    </common:PageHeader>

    <!-- Leftovers beside the list when there is room, below it when there is not -->
    <common:SplitPanel Grid.Row="2" Margin="{StaticResource FieldSpacing}" Breakpoint="900" SideWidth="380" SideHeight="220">

      <Border Style="{StaticResource Surface}" Padding="{StaticResource ListPadding}" Margin="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <!-- Column headers, inset to line up with the rows: row padding on the left, row
               padding plus the scroll bar on the right -->
          <Grid Margin="12,4,24,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{StaticResource IconColumnWidth}" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="{StaticResource DateColumnWidth}" />
              <ColumnDefinition Width="{StaticResource SizeColumnWidth}" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="{l:Tr Apps_ColName}" />
            <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="{l:Tr Apps_SortDate}" />
            <TextBlock Grid.Column="3" HorizontalAlignment="Right" Style="{StaticResource ColumnHeader}" Text="{l:Tr Apps_SortSize}" />
          </Grid>
          <ListBox Grid.Row="1" ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                   Visibility="{Binding State, Converter={StaticResource LoadStateVisible}, ConverterParameter='Idle,Loaded'}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource IconColumnWidth}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource DateColumnWidth}" />
                    <ColumnDefinition Width="{StaticResource SizeColumnWidth}" />
                  </Grid.ColumnDefinitions>
                  <!-- The app's own icon once loaded, or the generic outline when it has none -->
                  <Grid Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <common:AppIcon Width="24" Height="24" Kind="Apps" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                  </Grid>
                  <StackPanel Grid.Column="1" Margin="{StaticResource InlineGap}" VerticalAlignment="Center">
                    <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                    <TextBlock Style="{StaticResource TertiaryText}" TextTrimming="CharacterEllipsis" Text="{Binding Detail}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource DateCell}" Text="{Binding DateText}" />
                  <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SizeCell}" Text="{Binding SizeText}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <common:LoadStateOverlay Grid.Row="1" State="{Binding State}" ErrorMessage="{Binding ErrorMessage}" RetryCommand="{Binding ReloadCommand}" />
        </Grid>
      </Border>

      <!-- Found after an uninstall: shown unticked beside the list, removed only on request -->
      <Border Margin="0" VerticalAlignment="Top" Style="{StaticResource CollapsedWithoutLeftovers}">
          <StackPanel>
            <TextBlock Margin="{StaticResource LabelSpacing}" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding StatusText}" />
            <ItemsControl Margin="{StaticResource FieldSpacing}" ItemsSource="{Binding Leftovers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="{StaticResource LabelSpacing}">
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" Text="{Binding SizeText}" />
                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected}">
                      <TextBlock TextWrapping="Wrap" Text="{Binding Path}" />
                    </CheckBox>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ui:Button HorizontalAlignment="Right" Appearance="Danger" Command="{Binding RecycleLeftoversCommand}" Content="{l:Tr Analyze_Recycle}">
              <ui:Button.Icon>
                <common:AppIconElement Kind="Delete" />
              </ui:Button.Icon>
            </ui:Button>
          </StackPanel>
      </Border>
    </common:SplitPanel>

    <!-- Runs the app's own uninstaller after a confirmation -->
    <DockPanel Grid.Row="3">
      <ui:Button DockPanel.Dock="Right" Appearance="Danger" Command="{Binding UninstallCommand}" Content="{l:Tr Apps_Uninstall}">
        <ui:Button.Icon>
          <common:AppIconElement Kind="Delete" />
        </ui:Button.Icon>
      </ui:Button>
      <!-- The hint, or while and after an uninstall, what happened -->
      <TextBlock Margin="{StaticResource CardGap}" VerticalAlignment="Center" TextWrapping="Wrap">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
            <Setter Property="Text" Value="{Binding StatusText}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding StatusText}" Value="{x:Null}">
                <Setter Property="Text" Value="{l:Tr Apps_Hint}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </DockPanel>
  </Grid>
</Page>
