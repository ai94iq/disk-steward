<UserControl x:Class="MoleWin.App.Common.ActivityPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:MoleWin.App.Localization"
             xmlns:common="clr-namespace:MoleWin.App.Common"
             x:Name="Root">
  <!-- A page's Details: what it did, newest first, read only. Problems carry a warning icon
       so a refused or failed removal is never just another grey line. -->
  <Border Padding="{StaticResource ListPadding}" Style="{StaticResource Surface}" Margin="0">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Margin="8,4,8,8" FontWeight="SemiBold" Style="{StaticResource SecondaryText}" Text="{l:Tr Common_Details}" />
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <ItemsControl Margin="8,0,12,0" ItemsSource="{Binding ItemsSource, ElementName=Root}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type common:ActivityEntry}">
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="{StaticResource InlineGap}" Style="{StaticResource TertiaryText}" Text="{Binding TimeText}" />
                <DockPanel Grid.Column="1">
                  <common:AppIcon x:Name="Warn" DockPanel.Dock="Left" Width="14" Height="14" Margin="0,2,6,0" VerticalAlignment="Top"
                                  Kind="Warning" Foreground="{DynamicResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                  <TextBlock x:Name="Line" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{Binding Text}" />
                </DockPanel>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                  <Setter TargetName="Warn" Property="Visibility" Value="Visible" />
                  <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
