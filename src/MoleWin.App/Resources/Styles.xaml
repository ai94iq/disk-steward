<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="clr-namespace:MoleWin.App.Common">
  <!-- Shared resources only. Feature-specific styles stay in the feature folder. -->
  <common:LoadStateToVisibilityConverter x:Key="LoadStateVisible" />
  <common:LoadLevelBrushConverter x:Key="LoadLevelBrush" />

  <!-- Spacing tokens (4 px grid). Use these instead of literal margins. -->
  <Thickness x:Key="PagePadding">24</Thickness>
  <Thickness x:Key="SectionSpacing">0,0,0,32</Thickness>
  <Thickness x:Key="FieldSpacing">0,0,0,16</Thickness>
  <Thickness x:Key="LabelSpacing">0,0,0,4</Thickness>
  <Thickness x:Key="RowSpacing">0,8</Thickness>
  <Thickness x:Key="CardGap">0,0,16,0</Thickness>
  <Thickness x:Key="InlineGap">0,0,8,0</Thickness>
  <Thickness x:Key="InlineStart">8,0,0,0</Thickness>
  <Thickness x:Key="BadgePadding">10,4</Thickness>
  <Thickness x:Key="HeroGap">0,0,24,0</Thickness>
  <!-- List cards: no right padding, so the scroll bar sits on the card edge -->
  <Thickness x:Key="ListPadding">8,8,0,8</Thickness>
  <Thickness x:Key="PageScrollGap">0,0,8,0</Thickness>
  <Thickness x:Key="ListItemPadding">12,8</Thickness>
  <Thickness x:Key="ListItemMargin">0,1</Thickness>
  <Thickness x:Key="SurfacePadding">20</Thickness>
  <GridLength x:Key="GutterWidth">16</GridLength>
  <GridLength x:Key="SizeColumnWidth">96</GridLength>
  <GridLength x:Key="DateColumnWidth">140</GridLength>
  <GridLength x:Key="IconColumnWidth">48</GridLength>
  <CornerRadius x:Key="CardRadius">8</CornerRadius>

  <!-- List rows, for every list. WPF-UI's own item paints the whole selected row in the accent
       and switches its text to a dark brush (black on the dark theme); its background is set on
       a named part a style cannot reach, so this replaces the template: a subtle fill when
       hovered or selected, an accent bar on the left when selected, text color unchanged. -->
  <Style TargetType="ListBoxItem">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="Padding" Value="{StaticResource ListItemPadding}" />
    <Setter Property="Margin" Value="{StaticResource ListItemMargin}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Row" Background="Transparent" CornerRadius="4">
            <Grid>
              <Border x:Name="Bar" Width="3" Height="16" HorizontalAlignment="Left" CornerRadius="2"
                      Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A card that opens and closes at once. WPF-UI's CardExpander animates its height, which
       re-lays out the whole page every frame and stutters on long pages. Header: whatever the
       page puts there; clicking anywhere but its own controls toggles the card. -->
  <Style x:Key="CardSection" TargetType="Expander">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <Border CornerRadius="{StaticResource CardRadius}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
            <DockPanel>
              <ToggleButton DockPanel.Dock="Top" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Row" Padding="16,12" Background="Transparent" CornerRadius="{StaticResource CardRadius}">
                      <DockPanel>
                        <common:AppIcon x:Name="Chevron" DockPanel.Dock="Right" Width="16" Height="16" Margin="{StaticResource InlineStart}"
                                        Kind="ChevronDown" RenderTransformOrigin="0.5,0.5" />
                        <ContentPresenter VerticalAlignment="Center" />
                      </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Chevron" Property="RenderTransform">
                          <Setter.Value>
                            <RotateTransform Angle="180" />
                          </Setter.Value>
                        </Setter>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="Body" Margin="16,0,16,12" Visibility="Collapsed" />
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="Body" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tree rows. The standard template sizes the row to its content, so fixed columns either
       overflow a narrow tree or leave a wide one empty. Here the row fills the tree's width
       (children indent by the arrow column) and looks like a list row: subtle hover and
       selection fill, accent bar when selected. -->
  <Style TargetType="TreeViewItem">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TreeViewItem">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="Row" Grid.ColumnSpan="2" Margin="{StaticResource ListItemMargin}" Background="Transparent" CornerRadius="4">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Bar" Width="3" Height="16" HorizontalAlignment="Left" CornerRadius="2"
                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                <ToggleButton x:Name="Arrow" Focusable="False" ClickMode="Press"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border Background="Transparent">
                        <common:AppIcon x:Name="Chevron" Width="12" Height="12" Kind="ChevronRight" IsDirectional="True"
                                        RenderTransformOrigin="0.5,0.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="Chevron" Property="RenderTransform">
                            <Setter.Value>
                              <RotateTransform Angle="90" />
                            </Setter.Value>
                          </Setter>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch" />
              </Grid>
            </Border>
            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="HasItems" Value="False">
              <Setter TargetName="Arrow" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Labels and supporting lines under a value -->
  <Style x:Key="SecondaryText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style x:Key="TertiaryText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
  </Style>
  <Style x:Key="ColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource TertiaryText}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- One outlined surface per section; never nested -->
  <Style x:Key="Surface" TargetType="Border">
    <Setter Property="Padding" Value="{StaticResource SurfacePadding}" />
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="Margin" Value="{StaticResource FieldSpacing}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
</ResourceDictionary>
