<ui:FluentWindow x:Class="MoleWin.App.Shell.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:MoleWin.App.Localization"
                 xmlns:common="clr-namespace:MoleWin.App.Common"
                 xmlns:analyze="clr-namespace:MoleWin.App.Features.Analyze"
                 xmlns:clean="clr-namespace:MoleWin.App.Features.Clean"
                 xmlns:apps="clr-namespace:MoleWin.App.Features.Apps"
                 xmlns:monitor="clr-namespace:MoleWin.App.Features.Monitor"
                 Title="{l:Tr App_Name}"
                 Width="1200"
                 Height="800"
                 MinWidth="800"
                 MinHeight="500"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{l:Tr App_Name}" />

    <ui:NavigationView x:Name="RootNavigation"
                       Grid.Row="1"
                       PaneDisplayMode="Left"
                       IsBackButtonVisible="Collapsed"
                       IsPaneToggleVisible="False"
                       OpenPaneLength="200"
                       Transition="FadeInWithSlide"
                       TransitionDuration="200">
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Content="{l:Tr Nav_Clean}" TargetPageType="{x:Type clean:CleanPage}">
          <ui:NavigationViewItem.Icon>
            <common:AppIconElement Kind="Broom" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Content="{l:Tr Nav_Apps}" TargetPageType="{x:Type apps:AppsPage}">
          <ui:NavigationViewItem.Icon>
            <common:AppIconElement Kind="Apps" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Content="{l:Tr Nav_Analyze}" TargetPageType="{x:Type analyze:AnalyzePage}">
          <ui:NavigationViewItem.Icon>
            <common:AppIconElement Kind="DataPie" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Content="{l:Tr Nav_Monitor}" TargetPageType="{x:Type monitor:MonitorPage}">
          <ui:NavigationViewItem.Icon>
            <common:AppIconElement Kind="HeartPulse" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
      </ui:NavigationView.MenuItems>
    </ui:NavigationView>
  </Grid>
</ui:FluentWindow>
