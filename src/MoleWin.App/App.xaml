<Application x:Class="MoleWin.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="Resources/Fonts.xaml" />
        <ResourceDictionary Source="Resources/Styles.xaml" />
        <ResourceDictionary Source="Resources/Scrolling.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- WPF-UI 4.3 paints a pressed button's text and icon black on the dark theme. -->
      <Style TargetType="ui:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
        <Setter Property="PressedForeground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
