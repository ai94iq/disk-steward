<Application x:Class="MoleWin.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="Resources/Fonts.xaml" />
        <ResourceDictionary Source="Resources/Styles.xaml" />
        <ResourceDictionary Source="Resources/Scrolling.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- WPF-UI 4.3 paints a pressed button's text and icon black on the dark theme. Its button
           style sets PressedForeground from this key in its own triggers, which outrank a
           derived style's setter, so the key itself is redefined: the theme's secondary text
           color, which follows light, dark and theme changes. -->
      <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{DynamicResource TextFillColorSecondary}" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
