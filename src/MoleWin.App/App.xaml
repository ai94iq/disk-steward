<Application x:Class="MoleWin.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="Resources/Fonts.xaml" />
        <ResourceDictionary Source="Resources/Styles.xaml" />
        <ResourceDictionary Source="Resources/Scrolling.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- WPF-UI 4.3 turns a pressed button's text and icon black: its template's pressed trigger
           sets the button's own Foreground with Binding RelativeSource=TemplatedParent, which
           resolves to nothing on the button itself, so the text falls back to black whatever
           PressedForeground says. Style triggers outrank template triggers, so this style sets
           the pressed color directly: secondary text on plain buttons, secondary text-on-accent
           on filled ones. -->
      <Style TargetType="ui:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
        <Style.Triggers>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsMouseOver" Value="True" />
              <Condition Property="IsPressed" Value="True" />
            </MultiTrigger.Conditions>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
          </MultiTrigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsPressed" Value="True" />
              <Condition Property="Appearance" Value="Primary" />
            </MultiTrigger.Conditions>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorSecondaryBrush}" />
          </MultiTrigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsPressed" Value="True" />
              <Condition Property="Appearance" Value="Danger" />
            </MultiTrigger.Conditions>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorSecondaryBrush}" />
          </MultiTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
