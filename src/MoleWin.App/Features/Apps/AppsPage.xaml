<Page x:Class="MoleWin.App.Features.Apps.AppsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:MoleWin.App.Localization"
      xmlns:common="clr-namespace:MoleWin.App.Common"
      Style="{StaticResource {x:Type Page}}"
      ScrollViewer.CanContentScroll="False">
  <!-- CanContentScroll="False": WPF-UI's NavigationView then skips its own scroll viewer and
       the lists below get a real height (it wraps the page when this is true, the Page default). -->
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisible" />
    <common:AppIconConverter x:Key="AppIcon" />
    <Style x:Key="CollapsedWithoutLeftovers" TargetType="Border" BasedOn="{StaticResource Surface}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Leftovers.Count}" Value="0">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Page.Resources>

  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <common:PageHeader Grid.Row="0" Kind="Apps" Title="{l:Tr Nav_Apps}" Summary="{Binding CountText}">
      <common:PageHeader.Actions>
        <!-- Search and sort, as in Windows Settings > Installed apps -->
        <StackPanel Orientation="Horizontal">
          <ui:TextBox MinWidth="260" Margin="{StaticResource CardGap}"
                      PlaceholderText="{l:Tr Apps_Search}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
            <ui:TextBox.Icon>
              <common:AppIconElement Kind="Search" />
            </ui:TextBox.Icon>
          </ui:TextBox>
          <TextBlock Margin="{StaticResource InlineGap}" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" Text="{l:Tr Apps_SortBy}" />
          <ComboBox MinWidth="170" ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label"
                    SelectedValuePath="Value" SelectedValue="{Binding SortBy}" />
        </StackPanel>
      </common:PageHeader.Actions>
    </common:PageHeader>

    <!-- What the uninstall is doing right now -->
    <Border Grid.Row="1" Style="{StaticResource Surface}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisible}}">
      <DockPanel>
        <ui:Button DockPanel.Dock="Right" VerticalAlignment="Center" Command="{Binding StopWaitingCommand}" Content="{l:Tr Analyze_Stop}">
          <ui:Button.Icon>
            <common:AppIconElement Kind="Stop" />
          </ui:Button.Icon>
        </ui:Button>
        <StackPanel Margin="{StaticResource CardGap}">
          <ProgressBar Margin="{StaticResource LabelSpacing}" IsIndeterminate="True" />
          <TextBlock Text="{Binding StatusText}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" Margin="{StaticResource FieldSpacing}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Surface}" Padding="{StaticResource ListPadding}" Margin="0">
        <Grid>
          <ListBox ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp}"
                   VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   HorizontalContentAlignment="Stretch"
                   Visibility="{Binding State, Converter={StaticResource LoadStateVisible}, ConverterParameter='Idle,Loaded'}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="{StaticResource LabelSpacing}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{StaticResource SizeColumnWidth}" />
                  </Grid.ColumnDefinitions>
                  <!-- The app's own icon, or the generic outline when it has none -->
                  <Grid Width="32" Height="32" Margin="{StaticResource CardGap}" VerticalAlignment="Center">
                    <common:AppIcon Width="24" Height="24" Kind="Apps" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Image Source="{Binding App, Converter={StaticResource AppIcon}}" RenderOptions.BitmapScalingMode="HighQuality" />
                  </Grid>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                    <TextBlock Style="{StaticResource TertiaryText}" TextTrimming="CharacterEllipsis" Text="{Binding Detail}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Margin="{StaticResource CardGap}" VerticalAlignment="Center"
                             Style="{StaticResource SecondaryText}" Text="{Binding DateText}" />
                  <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding SizeText}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <common:LoadStateOverlay State="{Binding State}" ErrorMessage="{Binding ErrorMessage}" RetryCommand="{Binding ReloadCommand}" />
        </Grid>
      </Border>

      <!-- Found after an uninstall: shown unticked beside the list, removed only on request -->
      <Border Grid.Column="1" Width="380" Margin="{StaticResource SideGap}" VerticalAlignment="Top" Style="{StaticResource CollapsedWithoutLeftovers}">
          <StackPanel>
            <TextBlock Margin="{StaticResource LabelSpacing}" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding StatusText}" />
            <ItemsControl Margin="{StaticResource FieldSpacing}" ItemsSource="{Binding Leftovers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="{StaticResource LabelSpacing}">
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" Text="{Binding SizeText}" />
                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected}">
                      <TextBlock TextWrapping="Wrap" Text="{Binding Path}" />
                    </CheckBox>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ui:Button HorizontalAlignment="Right" Appearance="Danger" Command="{Binding RecycleLeftoversCommand}" Content="{l:Tr Analyze_Recycle}">
              <ui:Button.Icon>
                <common:AppIconElement Kind="Delete" />
              </ui:Button.Icon>
            </ui:Button>
          </StackPanel>
      </Border>
    </Grid>

    <!-- Runs the app's own uninstaller after a confirmation -->
    <DockPanel Grid.Row="3">
      <ui:Button DockPanel.Dock="Right" Appearance="Danger" Command="{Binding UninstallCommand}" Content="{l:Tr Apps_Uninstall}">
        <ui:Button.Icon>
          <common:AppIconElement Kind="Delete" />
        </ui:Button.Icon>
      </ui:Button>
      <TextBlock VerticalAlignment="Center" Style="{StaticResource TertiaryText}" TextWrapping="Wrap" Text="{l:Tr Apps_Hint}" />
    </DockPanel>
  </Grid>
</Page>
