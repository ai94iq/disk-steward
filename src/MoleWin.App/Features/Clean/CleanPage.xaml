<Page x:Class="MoleWin.App.Features.Clean.CleanPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:MoleWin.App.Localization"
      xmlns:common="clr-namespace:MoleWin.App.Common"
      Style="{StaticResource {x:Type Page}}"
      ScrollViewer.CanContentScroll="False">
  <!-- CanContentScroll="False": WPF-UI's NavigationView then skips its own scroll viewer and
       the lists below get a real height (it wraps the page when this is true, the Page default). -->
  <Page.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RescanCommand}" />
    <KeyBinding Key="Delete" Command="{Binding RecycleSelectedCommand}" />
  </Page.InputBindings>
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisible" />
    <common:CategoryBrushConverter x:Key="CategoryBrush" />

    <!-- The headline shows once a scan has found something. -->
    <Style x:Key="ShownWithResults" TargetType="StackPanel">
      <Style.Triggers>
        <DataTrigger Binding="{Binding SafeText}" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsScanning}" Value="True">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Mole's signature: green means "safe to remove" and is used for nothing else on this
         page. Each group card is tinted green or amber (fill and edge), the legend under the
         headline names both, and screen readers get the same words as help text, so the color
         never carries the meaning alone. -->
    <Style x:Key="GroupSection" TargetType="Expander" BasedOn="{StaticResource CardSection}">
      <Setter Property="Background" Value="{DynamicResource SafeTint}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SafeEdge}" />
      <Setter Property="AutomationProperties.HelpText" Value="{l:Tr Clean_Safe}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSafe}" Value="False">
          <Setter Property="Background" Value="{DynamicResource ReviewTint}" />
          <Setter Property="BorderBrush" Value="{DynamicResource ReviewEdge}" />
          <Setter Property="AutomationProperties.HelpText" Value="{l:Tr Clean_Review}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LegendSwatch" TargetType="Border">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Page.Resources>

  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <common:PageHeader Grid.Row="0" Kind="Broom" Title="{l:Tr Nav_Clean}" Summary="{Binding ScanSummary}">
      <common:PageHeader.Actions>
        <ui:Button Command="{Binding RescanCommand}" Content="{l:Tr Clean_Rescan}" ToolTip="F5">
          <ui:Button.Icon>
            <common:AppIconElement Kind="ArrowSync" />
          </ui:Button.Icon>
        </ui:Button>
      </common:PageHeader.Actions>
    </common:PageHeader>

    <!-- Live scan: which rule is being checked, the folder being read, how long, how much -->
    <Border Grid.Row="1" Style="{StaticResource StatusSurface}" Visibility="{Binding IsScanning, Converter={StaticResource BoolVisible}}">
      <StackPanel>
        <ProgressBar Margin="{StaticResource LabelSpacing}" IsIndeterminate="True" />
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" Text="{Binding ElapsedText}" />
          <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding ScanningText}" />
        </DockPanel>
        <TextBlock Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Text="{Binding CountersText}" />
        <TextBlock Style="{StaticResource TertiaryText}" TextTrimming="CharacterEllipsis" Text="{Binding CurrentFolder}" />
      </StackPanel>
    </Border>

    <!-- The answer first: how much goes without a second thought, then the whole picture -->
    <StackPanel Grid.Row="2" Margin="{StaticResource FieldSpacing}" Style="{StaticResource ShownWithResults}">
      <TextBlock FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap">
        <Run Foreground="{DynamicResource SystemFillColorSuccessBrush}" Text="{Binding SafeText, Mode=OneWay}" /><Run Text="{l:Tr Clean_HeadlineRest}" />
      </TextBlock>
      <TextBlock Margin="0,4,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{Binding HeadlineDetail}" />
      <WrapPanel Margin="0,8,0,0">
        <StackPanel Margin="0,0,24,0" Orientation="Horizontal">
          <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource SafeTint}"
                  BorderBrush="{DynamicResource SafeEdge}" />
          <TextBlock Style="{StaticResource SecondaryText}" Text="{l:Tr Clean_Safe}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource ReviewTint}"
                  BorderBrush="{DynamicResource ReviewEdge}" />
          <TextBlock Style="{StaticResource SecondaryText}" Text="{l:Tr Clean_Review}" />
        </StackPanel>
      </WrapPanel>
    </StackPanel>

    <!-- Details on the right when there is room, below the groups when there is not -->
    <common:SplitPanel Grid.Row="3" Margin="{StaticResource FieldSpacing}" SideWidth="240">
      <Grid>
        <ScrollViewer Padding="{StaticResource PageScrollGap}" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding State, Converter={StaticResource LoadStateVisible}, ConverterParameter='Idle,Loading,Loaded'}">
          <ItemsControl ItemsSource="{Binding Categories}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <!-- One card per category: collapsed shows the total and what it is, opened shows each place -->
                <Expander Margin="{StaticResource LabelSpacing}" Style="{StaticResource GroupSection}" IsExpanded="{Binding IsExpanded}"
                          AutomationProperties.Name="{Binding Name}" common:Motion.FadeIn="True">
                  <Expander.Header>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Name}" />
                      <!-- The category's color twice: a faint tile behind, the full color on the icon -->
                      <Grid Grid.Column="1" Width="40" Height="40" Margin="{StaticResource InlineGap}">
                        <Border CornerRadius="10" Opacity="0.16" Background="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                        <common:AppIcon Width="22" Height="22" Kind="{Binding Icon}"
                                        Foreground="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                      </Grid>
                      <StackPanel Grid.Column="2" Margin="{StaticResource InlineGap}" VerticalAlignment="Center">
                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Text="{Binding Note}" ToolTip="{Binding Note}" />
                      </StackPanel>
                      <StackPanel Grid.Column="3" Margin="{StaticResource CardGap}" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Right" FontSize="16" FontWeight="SemiBold" Text="{Binding SizeText}" />
                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource TertiaryText}" Text="{Binding ItemsText}" />
                      </StackPanel>
                    </Grid>
                  </Expander.Header>
                  <ItemsControl ItemsSource="{Binding Targets}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="{StaticResource RowSpacing}" Background="Transparent" ToolTip="{Binding PathsPreview}">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" MaxWidth="200" />
                            <ColumnDefinition Width="{StaticResource SizeColumnWidth}" />
                          </Grid.ColumnDefinitions>
                          <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Label}" />
                          <StackPanel Grid.Column="1" Margin="{StaticResource InlineGap}" VerticalAlignment="Center">
                            <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Label}" />
                            <TextBlock Style="{StaticResource TertiaryText}" TextTrimming="CharacterEllipsis" Text="{Binding DetailText}" />
                          </StackPanel>
                          <ProgressBar Grid.Column="2" Height="6" Margin="{StaticResource CardGap}" VerticalAlignment="Center"
                                       Maximum="100" common:Motion.Value="{Binding Share}" />
                          <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Style="{StaticResource SecondaryText}" Text="{Binding SizeText}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <common:LoadStateOverlay State="{Binding State}" ErrorMessage="{Binding ErrorMessage}"
                                 EmptyText="{Binding EmptyText}" RetryCommand="{Binding RescanCommand}" />
      </Grid>

      <common:ActivityPanel ItemsSource="{Binding Activity}" />
    </common:SplitPanel>

    <!-- The only way anything is removed: ticked rows, this button, then a confirmation.
         Recycle Bin removal can be undone, so it wears the safe color, not the danger red. -->
    <DockPanel Grid.Row="4">
      <ui:Button DockPanel.Dock="Right" Appearance="Success" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                 Command="{Binding RecycleSelectedCommand}" Content="{Binding RecycleText}" ToolTip="Del">
        <ui:Button.Icon>
          <common:AppIconElement Kind="Delete" />
        </ui:Button.Icon>
      </ui:Button>
      <StackPanel Margin="{StaticResource CardGap}" VerticalAlignment="Center">
        <TextBlock FontWeight="SemiBold" Text="{Binding SelectedText}" />
        <TextBlock Style="{StaticResource TertiaryText}" TextWrapping="Wrap" Text="{l:Tr Clean_Hint}" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Page>
