<Page x:Class="MoleWin.App.Features.Analyze.AnalyzePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:MoleWin.App.Localization"
      xmlns:common="clr-namespace:MoleWin.App.Common"
      xmlns:analyze="clr-namespace:MoleWin.App.Features.Analyze"
      Style="{StaticResource {x:Type Page}}"
      ScrollViewer.CanContentScroll="False">
  <!-- CanContentScroll="False": WPF-UI's NavigationView then skips its own scroll viewer and
       the tree below gets a real height (it wraps the page when this is true, the Page default). -->
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisible" />

    <!-- The tree drives IsExpanded both ways so opening a node can list it. -->
    <Style x:Key="NodeContainer" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
    </Style>

    <!-- Shows a row only for one kind of node. -->
    <Style x:Key="DriveRow" TargetType="Grid">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static analyze:FolderKind.Drive}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ItemRow" TargetType="Grid">
      <Setter Property="Visibility" Value="Visible" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static analyze:FolderKind.Drive}">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static analyze:FolderKind.Placeholder}">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="FileIcon" TargetType="common:AppIcon">
      <Setter Property="Kind" Value="Folder" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static analyze:FolderKind.File}">
          <Setter Property="Kind" Value="Document" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LockedTag" TargetType="StackPanel">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSystem}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsProtected}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- System items: Windows uses them. Protected items: MoleWin's own safety rules. -->
    <Style x:Key="LockedText" TargetType="TextBlock" BasedOn="{StaticResource TertiaryText}">
      <Setter Property="Text" Value="{l:Tr Analyze_Protected}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSystem}" Value="True">
          <Setter Property="Text" Value="{l:Tr Analyze_SystemItem}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Page.Resources>

  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <common:PageHeader Grid.Row="0" Kind="DataPie" Title="{l:Tr Nav_Analyze}" Summary="{l:Tr Analyze_Summary}" />

    <!-- Live measuring: what it is reading now, how long, how much -->
    <Border Grid.Row="1" Style="{StaticResource Surface}" Visibility="{Binding IsScanning, Converter={StaticResource BoolVisible}}">
      <DockPanel>
        <ui:Button DockPanel.Dock="Right" VerticalAlignment="Center" Command="{Binding StopCommand}" Content="{l:Tr Analyze_Stop}">
          <ui:Button.Icon>
            <common:AppIconElement Kind="Stop" />
          </ui:Button.Icon>
        </ui:Button>
        <StackPanel Margin="{StaticResource CardGap}">
          <ProgressBar Margin="{StaticResource LabelSpacing}" IsIndeterminate="True" />
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" Text="{Binding ElapsedText}" />
            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding CountersText}" />
          </DockPanel>
          <TextBlock Style="{StaticResource TertiaryText}" TextTrimming="CharacterEllipsis" Text="{Binding CurrentFolder}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" Margin="{StaticResource FieldSpacing}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border Margin="0" Padding="{StaticResource ListPadding}" Style="{StaticResource Surface}">
        <Grid>
          <TreeView ItemsSource="{Binding Roots}" ItemContainerStyle="{StaticResource NodeContainer}"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard"
                    Visibility="{Binding State, Converter={StaticResource LoadStateVisible}, ConverterParameter='Idle,Loaded'}">
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding Children}" ItemContainerStyle="{StaticResource NodeContainer}">
                <Grid>
                  <!-- A drive: what it holds against what it can hold -->
                  <Grid Style="{StaticResource DriveRow}" Margin="{StaticResource RowSpacing}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="{StaticResource NameColumnWidth}" />
                      <ColumnDefinition Width="{StaticResource BarColumnWidth}" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <common:AppIcon Width="24" Height="24" Margin="{StaticResource InlineGap}" Kind="HardDrive" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                      <TextBlock Style="{StaticResource TertiaryText}" Text="{Binding FreeText}" />
                    </StackPanel>
                    <ProgressBar Grid.Column="2" Height="8" VerticalAlignment="Center" Maximum="100"
                                 Foreground="{Binding Level, Converter={StaticResource LoadLevelBrush}}"
                                 common:Motion.Value="{Binding UsedPercent}" />
                    <TextBlock Grid.Column="3" Margin="{StaticResource InlineStart}" VerticalAlignment="Center"
                               FontWeight="SemiBold" Text="{Binding SizeText}" />
                  </Grid>

                  <!-- A folder or file: tick it to remove, unless Windows needs it -->
                  <Grid Style="{StaticResource ItemRow}" Margin="{StaticResource RowSpacing}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="{StaticResource NameColumnWidth}" />
                      <ColumnDefinition Width="{StaticResource BarColumnWidth}" />
                      <ColumnDefinition Width="{StaticResource SizeColumnWidth}" />
                    </Grid.ColumnDefinitions>
                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" />
                    <common:AppIcon Grid.Column="1" Width="18" Height="18" Margin="{StaticResource InlineGap}" Style="{StaticResource FileIcon}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                      <StackPanel Orientation="Horizontal" Style="{StaticResource LockedTag}" ToolTip="{l:Tr Analyze_SystemTip}">
                        <common:AppIcon Width="14" Height="14" Margin="{StaticResource InlineGap}" Kind="Shield"
                                        Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock Style="{StaticResource LockedText}" />
                      </StackPanel>
                    </StackPanel>
                    <ProgressBar Grid.Column="3" Height="6" VerticalAlignment="Center" Maximum="100" common:Motion.Value="{Binding Share}" />
                    <Grid Grid.Column="4" VerticalAlignment="Center">
                      <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding SizeText}" />
                      <TextBlock HorizontalAlignment="Right" Style="{StaticResource TertiaryText}" Text="{l:Tr Analyze_Measuring}"
                                 Visibility="{Binding IsMeasuring, Converter={StaticResource BoolVisible}}" />
                    </Grid>
                  </Grid>
                </Grid>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
          <common:LoadStateOverlay State="{Binding State}" ErrorMessage="{Binding ErrorMessage}" RetryCommand="{Binding ReloadCommand}" />
        </Grid>
      </Border>

      <!-- Every folder read and everything removed, always in view -->
      <Border Grid.Column="1" Width="300" Margin="{StaticResource SideGap}" Padding="{StaticResource ListPadding}" Style="{StaticResource Surface}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Margin="8,4,8,8" FontWeight="SemiBold" Style="{StaticResource SecondaryText}" Text="{l:Tr Common_Details}" />
          <ListBox ItemsSource="{Binding Activity}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource TertiaryText}" TextWrapping="Wrap" Text="{Binding}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>

    <!-- The only way anything is removed: ticked rows, this button, then a confirmation -->
    <DockPanel Grid.Row="3">
      <ui:Button DockPanel.Dock="Right" Appearance="Danger" Command="{Binding RecycleSelectedCommand}" Content="{l:Tr Analyze_Recycle}">
        <ui:Button.Icon>
          <common:AppIconElement Kind="Delete" />
        </ui:Button.Icon>
      </ui:Button>
      <StackPanel VerticalAlignment="Center">
        <TextBlock FontWeight="SemiBold" Text="{Binding SelectedText}" />
        <TextBlock Style="{StaticResource TertiaryText}" Text="{l:Tr Analyze_Hint}" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Page>
