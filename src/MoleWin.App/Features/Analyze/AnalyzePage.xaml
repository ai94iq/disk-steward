<Page x:Class="MoleWin.App.Features.Analyze.AnalyzePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:MoleWin.App.Localization"
      xmlns:common="clr-namespace:MoleWin.App.Common"
      Style="{StaticResource {x:Type Page}}"
      ScrollViewer.CanContentScroll="False">
  <!-- CanContentScroll="False": WPF-UI's NavigationView then skips its own scroll viewer and
       the list below gets a real height (it wraps the page when this is true, the Page default). -->
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisible" />
  </Page.Resources>

  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Title, where we are, and the way back up -->
    <DockPanel Grid.Row="0" Margin="{StaticResource FieldSpacing}">
      <ui:Button DockPanel.Dock="Right" VerticalAlignment="Center" Command="{Binding UpCommand}" Content="{l:Tr Analyze_Up}">
        <ui:Button.Icon>
          <common:AppIconElement Kind="ArrowUp" />
        </ui:Button.Icon>
      </ui:Button>
      <StackPanel>
        <ui:TextBlock FontTypography="Title" Text="{l:Tr Nav_Analyze}" />
        <TextBlock Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Text="{Binding Location, TargetNullValue={l:Tr Analyze_Drives}}" />
      </StackPanel>
    </DockPanel>

    <!-- Live scan: what it is reading now, how long, how much -->
    <Border Grid.Row="1" Style="{StaticResource Surface}" Visibility="{Binding IsScanning, Converter={StaticResource BoolVisible}}">
      <DockPanel>
        <ui:Button DockPanel.Dock="Right" VerticalAlignment="Center" Command="{Binding StopCommand}" Content="{l:Tr Analyze_Stop}">
          <ui:Button.Icon>
            <common:AppIconElement Kind="Stop" />
          </ui:Button.Icon>
        </ui:Button>
        <StackPanel Margin="{StaticResource CardGap}">
          <ProgressBar Margin="{StaticResource LabelSpacing}" IsIndeterminate="True" />
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" Text="{Binding ElapsedText}" />
            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding CountersText}" />
          </DockPanel>
          <TextBlock Style="{StaticResource TertiaryText}" TextTrimming="CharacterEllipsis" Text="{Binding CurrentFolder}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" Margin="{StaticResource FieldSpacing}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="{StaticResource GutterWidth}" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Folder contents, largest first -->
      <Border Style="{StaticResource Surface}" Padding="{StaticResource ListPadding}" Margin="0">
        <Grid>
          <!-- A plain virtualized ItemsControl: WPF-UI's ListView dropped the row's data context
               after the first value (measured with binding traces), so rows render without it. -->
          <ItemsControl ItemsSource="{Binding Rows}"
                        VirtualizingPanel.IsVirtualizing="True"
                        ScrollViewer.CanContentScroll="True"
                        Visibility="{Binding State, Converter={StaticResource LoadStateVisible}, ConverterParameter='Idle,Loaded'}">
            <ItemsControl.Template>
              <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter />
                </ScrollViewer>
              </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="{StaticResource RowSpacing}" Background="Transparent" ToolTip="{Binding Path}">
                  <Grid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick"
                                  Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding Path}" />
                  </Grid.InputBindings>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource SizeColumnWidth}" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" />
                  <common:AppIcon Grid.Column="1" Width="20" Height="20" Margin="{StaticResource InlineGap}" Kind="Folder"
                                  Visibility="{Binding IsDirectory, Converter={StaticResource BoolVisible}}" />
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                    <TextBlock Style="{StaticResource TertiaryText}" Text="{l:Tr Analyze_Protected}"
                               Visibility="{Binding IsProtected, Converter={StaticResource BoolVisible}}" />
                  </StackPanel>
                  <ProgressBar Grid.Column="3" Height="6" Margin="{StaticResource CardGap}" VerticalAlignment="Center"
                               Maximum="100" common:Motion.Value="{Binding Share}" />
                  <Grid Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding SizeText}" />
                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource TertiaryText}" Text="{l:Tr Analyze_Measuring}"
                               Visibility="{Binding IsMeasuring, Converter={StaticResource BoolVisible}}" />
                  </Grid>
                  <ui:Button Grid.Column="5" Margin="{StaticResource InlineStart}" Padding="6" Appearance="Transparent"
                             Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                             CommandParameter="{Binding Path}"
                             Visibility="{Binding IsDirectory, Converter={StaticResource BoolVisible}}">
                    <common:AppIcon Width="16" Height="16" Kind="ChevronRight" IsDirectional="True" />
                  </ui:Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <common:LoadStateOverlay State="{Binding State}" ErrorMessage="{Binding ErrorMessage}" RetryCommand="{Binding ReloadCommand}" />
        </Grid>
      </Border>

      <!-- What the scan and removals did, newest first -->
      <Border Grid.Column="2" Style="{StaticResource Surface}" Margin="0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Margin="{StaticResource FieldSpacing}" Style="{StaticResource SecondaryText}" Text="{l:Tr Analyze_Activity}" />
          <ListBox ItemsSource="{Binding Activity}" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource TertiaryText}" TextWrapping="Wrap" Text="{Binding}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>

    <!-- The only way anything is removed: ticked rows, this button, then a confirmation -->
    <DockPanel Grid.Row="3">
      <ui:Button DockPanel.Dock="Right" Appearance="Danger" Command="{Binding RecycleSelectedCommand}" Content="{l:Tr Analyze_Recycle}">
        <ui:Button.Icon>
          <common:AppIconElement Kind="Delete" />
        </ui:Button.Icon>
      </ui:Button>
      <StackPanel VerticalAlignment="Center">
        <TextBlock FontWeight="SemiBold" Text="{Binding SelectedText}" />
        <TextBlock Style="{StaticResource TertiaryText}" Text="{l:Tr Analyze_Hint}" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Page>
