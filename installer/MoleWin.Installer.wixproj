<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputName>MoleWin-Setup-$(Version)</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>ar-SA</Cultures>
    <PublishDir>$(MSBuildThisFileDirectory)..\artifacts\publish\win-x64</PublishDir>
    <DefineConstants>Version=$(Version);PublishDir=$(PublishDir)</DefineConstants>
    <!-- WiX packages are versioned here, not through CPM; keep both on the same 6.x version -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- WinAppSDK ships localized .mui files that ICE03 rejects, and Files-based payloads without
         language resources trip ICE60; suppress both for that layout only -->
    <SuppressIces Condition="Exists('$(PublishDir)\Microsoft.ui.xaml.dll')">ICE03;ICE60</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>
</Project>
